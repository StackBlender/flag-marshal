{
  "name": "@stackblender/flag-marshal",
  "version": "0.1.3",
  "description": "Local-first feature-flag technical-debt analysis and governance.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "StackBlender",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "flag-marshal": "./dist/frontends/cli/main.js",
    "marshal": "./dist/frontends/cli/main.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/minify-dist.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run notices:check && npm run build && npm run assemble:npm && node scripts/assemble-vscode-extension.mjs --link && npm test",
    "generate:types": "node scripts/generate-types.mjs",
    "build:goldens": "node scripts/build-goldens.mjs",
    "generate": "npm run generate:types && npm run build:goldens",
    "corpus": "node scripts/scan-corpus.mjs",
    "corpus:check": "node scripts/scan-corpus.mjs --check",
    "corpus:update": "node scripts/scan-corpus.mjs --update",
    "build:fast": "npm run clean && tsc -p tsconfig.build.json",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "assemble:npm": "node scripts/assemble-npm-package.mjs",
    "assemble:vscode": "node scripts/assemble-vscode-extension.mjs",
    "extension:dev": "npm run build && node scripts/assemble-vscode-extension.mjs --link",
    "package:vscode": "npm run check && npm run assemble:vscode",
    "build:integration": "esbuild test/integration/*.test.ts --bundle --outdir=artifacts/vscode-test --format=cjs --platform=node --target=node20 --external:vscode --out-extension:.js=.cjs",
    "test:integration": "npm run extension:dev && npm run build:integration && vscode-test",
    "package:npm": "npm run check && npm run test:npm-package && npm pack ./artifacts/npm/package --pack-destination ./artifacts/npm",
    "test:npm-package": "node scripts/test-npm-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.137.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "json-schema-to-typescript": "^16.0.0",
    "mocha": "^12.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tree-sitter-grammars/tree-sitter-kotlin": "^1.1.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "ignore": "^7.0.9",
    "web-tree-sitter": "^0.27.0",
    "yaml": "^2.9.0"
  }
}
